<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4">
            <!-- MAIN FEED SECTION (3/4 width on desktop) -->
            <div class="col-12 col-lg-8 col-xl-9">
                <!-- Challenge Tabs & Search/Upload Controls -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <!-- Challenge Filter Tabs -->
                    <ul class="nav nav-pills gap-2 flex-nowrap overflow-x-auto pb-2 pb-md-0" id="challengeTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold text-dark bg-transparent border-0 px-0 me-3 custom_challenge-tab rounded-0" id="current-tab" data-bs-toggle="pill" data-bs-target="#current" type="button" role="tab">Current Challenge</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link text-secondary opacity-50 bg-transparent border-0 px-0 me-3 custom_challenge-tab rounded-0" id="past-tab" data-bs-toggle="pill" data-bs-target="#past" type="button" role="tab">Past Challenges</button>
                        </li>
                    </ul>
                    <!-- Action Bar: Search Input & Video Upload Button -->
                    <div class="d-flex align-items-center gap-2 ms-auto ms-md-0">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input class="form-control border-start-0 rounded-end-pill pe-3" placeholder="Search videos" type="search" aria-label="Search challenge videos">
                        </div>
                        <!-- Upload Modal Trigger / File Input -->
                        <label class="btn btn-dark btn-sm rounded-pill px-3 text-nowrap mb-0">
                            <i class="bi bi-plus-lg me-1"></i>
                            Upload
                            <input type="file" accept="video/*" class="d-none">
                        </label>
                    </div>
                </div>
