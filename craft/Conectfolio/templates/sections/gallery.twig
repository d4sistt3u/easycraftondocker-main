<section class="py-5 bg-light overflow-hidden">
    <div class="container">
        <div class="d-flex align-items-center overflow-x-auto py-3 custom_gallery-puzzle-container">
            <!-- Upload Card Trigger (Left Edge) -->
            <label class="d-flex flex-column align-items-center justify-content-center bg-white rounded-4 shadow-sm border border-2 flex-shrink-0 me-4 custom_gallery-upload-card">
                <i class="bi bi-plus-circle fs-2 text-secondary mb-2"></i>
                <span class="small fw-semibold text-secondary text-center px-3">Add to Gallery</span>
                <input type="file" accept="image/*,video/*" multiple class="d-none">
            </label>
            <!-- Horizontal Gallery Puzzle Track -->
            <div class="d-flex align-items-stretch gap-4 flex-nowrap">
                <div class="custom_gallery-slot flex-shrink-0 rounded-4 overflow-hidden shadow-sm">
                    <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&amp;w=1000&amp;auto=format&amp;fit=crop" class="w-100 h-100 object-fit-cover" alt="Portfolio item">
                </div>
                <div class="d-flex flex-column gap-3 flex-shrink-0 custom_gallery-stacked-slot">
                    <div class="h-50 rounded-4 overflow-hidden shadow-sm">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&amp;w=600&amp;auto=format&amp;fit=crop" class="w-100 h-100 object-fit-cover" alt="Portfolio item top">
                    </div>
                    <div class="h-50 rounded-4 overflow-hidden shadow-sm">
                        <img src="https://images.unsplash.com/photo-1513542789411-b6a5d4f31634?q=80&amp;w=600&amp;auto=format&amp;fit=crop" class="w-100 h-100 object-fit-cover" alt="Portfolio item bottom">
                    </div>
                </div>
                <div class="custom_gallery-slot-wide flex-shrink-0 rounded-4 overflow-hidden shadow-sm">
                    <img src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?q=80&amp;w=1200&amp;auto=format&amp;fit=crop" class="w-100 h-100 object-fit-cover" alt="Portfolio item wide">
                </div>
                <div class="custom_gallery-slot flex-shrink-0 rounded-4 overflow-hidden shadow-sm">
                    <img src="https://images.unsplash.com/photo-1509198397868-475647b2a1e5?q=80&amp;w=1000&amp;auto=format&amp;fit=crop" class="w-100 h-100 object-fit-cover" alt="Portfolio item">
                </div>
                <div class="d-flex flex-column gap-3 flex-shrink-0 custom_gallery-stacked-slot">
                    <div class="h-50 rounded-4 overflow-hidden shadow-sm">
                        <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&amp;w=600&amp;auto=format&amp;fit=crop" class="w-100 h-100 object-fit-cover" alt="Portfolio item top">
                    </div>
                    <div class="h-50 rounded-4 overflow-hidden shadow-sm">
                        <img src="https://images.unsplash.com/photo-1475721027785-f74eccf877e2?q=80&amp;w=600&amp;auto=format&amp;fit=crop" class="w-100 h-100 object-fit-cover" alt="Portfolio item bottom">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
