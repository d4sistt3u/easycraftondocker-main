<section class="py-5 bg-white">
    <div class="container py-3">
        <!-- Section Title Header -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-3 mb-4">
            <div>
                <div class="text-uppercase fw-semibold text-secondary small mb-1">SPEED DISCOVER</div>
                <h2 class="display-6 text-dark fw-bold mb-0">Portfolios for you</h2>
            </div>
        </div>
        <!-- Swipe Deck Container -->
        <div class="d-flex justify-content-center align-items-center px-4">
            <div class="custom_swipe-deck-container w-100 position-relative">
                <!-- Dislike (X) Button -->
                <button class="btn shadow rounded-circle d-flex align-items-center justify-content-center custom_action-btn bg-white top-50 translate-middle-y border custom_btn-dislike position-absolute z-3" aria-label="Dislike">
                    <i class="bi bi-x-lg fs-4 text-dark"></i>
                </button>
                <!-- Like (Heart) Button -->
                <button class="btn shadow rounded-circle d-flex align-items-center justify-content-center custom_action-btn bg-white top-50 translate-middle-y border custom_btn-like position-absolute z-3" aria-label="Like">
                    <i class="bi bi-heart-fill fs-5 text-danger"></i>
                </button>
                <!-- Stacked Card 3 (Bottom) -->
                <div class="card custom_card-transition border rounded-4 position-absolute w-100 h-100 custom_card-deck-3 top-0 start-0 z-0 bg-light"></div>
                <!-- Stacked Card 2 (Middle) -->
                <div class="card custom_card-transition border rounded-4 position-absolute w-100 h-100 custom_card-deck-2 top-0 start-0 z-1 bg-light"></div>
                <!-- Main Card 1 (Top Active) -->
                {% include 'components/discover-card.twig' %}
            </div>
        </div>
    </div>
</section>
