{% extends 'base.html.twig' %}
{% block title %}Style Guide | Connectfolio{% endblock %}
{% block content %}
    {% include 'sections/hero.twig' %}
    {% include 'sections/portfolio-section.twig' %}
    {% include 'sections/challenge.twig' %}
    {% include 'sections/events.twig' %}
    {% include 'sections/insights.twig' %}
    <div class="container pb-4 pb-md-5">
        <h2 class="fw-bold mb-2">Video Card &amp; Modal</h2>
        <p class="text-secondary mb-4">Hover over a video to preview it. Click the video to watch it fullscreen.</p>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
            {% include 'components/video-card.twig' %}
        </div>
    </div>
    {% include 'sections/challenge-feed.twig' %}
    {% include 'sections/discover.twig' %}
    {% include 'sections/gallery.twig' %}
    <div class="container py-5">
        {% include 'sections/about.twig' %}
        {% include 'sections/contact.twig' %}
    </div>
    {% include 'components/button-sample.twig' %}
    <a href="#" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold">Button2</a>
{% endblock %}
{% block video_modal %}
    <div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="videoModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content bg-black">
                <div class="modal-header border-0">
                    <span class="visually-hidden" id="videoModalTitle">View video</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close video"></button>
                </div>
                <div class="modal-body d-flex align-items-center justify-content-center">
                    <video class="mw-100 mh-100 object-fit-contain" controls playsinline preload="none" aria-label="Video viewer"></video>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
